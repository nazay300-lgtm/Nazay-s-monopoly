{
  "name": "nazays-monopoly",
  "version": "1.3.0",
  "description": "Nazay's Monopoly",
  "main": "main.js",
  "author": "Nazay",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "release": "electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "ru.nazay.monopoly",
    "productName": "Nazays Monopoly",
    "files": [
      "**/*",
      "!dist/**",
      "!**/*.md"
    ],
    "win": {
      "target": "nsis"
    },
    "publish": {
      "provider": "github",
      "owner": "nazay300-lgtm",
      "repo": "Nazay-s-monopoly"
    }
  }
}